{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],

    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "~/components/*": [
        "components/*"
      ],
      "~/hooks/*": [
        "hooks/*"
      ],
      "~/lib/*": [
        "lib/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "components/VoiceInputEn.jsx",
    "components/VoiceInputBn.jsx",
    "hooks/useVoiceTyping.js"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "playwright.config.ts"
  ]
}

